{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: exactly the host commands the UI uses, and event listening for the typed events.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-hermes-status",
    "allow-hermes-install",
    "allow-hermes-retry",
    "allow-setup-check",
    "allow-setup-advance",
    "allow-setup-reopen-models",
    "allow-setup-models-view",
    "allow-hermes-source-get",
    "allow-hermes-source-set",
    "allow-gateway-connect",
    "allow-gateway-send",
    "allow-gateway-disconnect",
    "allow-gateway-stats",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-secret-exists",
    "allow-app-settings-get",
    "allow-app-settings-set",
    "allow-notify",
    "allow-pick-folder",
    "allow-open-external",
    "allow-renderer-report",
    "allow-renderer-open-gpu-page",
    "allow-app-restart",
    "allow-connector-catalog",
    "allow-connector-inputs",
    "allow-connector-review",
    "allow-connector-install",
    "allow-connector-list",
    "allow-connector-test",
    "allow-connector-set-enabled",
    "allow-connector-remove",
    "allow-connector-signin",
    "allow-connector-signin-cancel",
    "allow-connector-login"
  ]
}
