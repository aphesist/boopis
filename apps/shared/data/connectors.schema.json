{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aphesist/boopis/apps/shared/data/connectors.schema.json",
  "title": "boopis connector collection",
  "type": "object",
  "required": ["schema_version", "connectors"],
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string" },
    "popularity": {
      "description": "How the array is ordered: the signal, the date it was read and the run that read it. An entry's own `popularity` holds its count.",
      "type": "object",
      "required": ["signal", "read", "evidence"],
      "properties": {
        "signal": { "const": "github-stars" },
        "read": { "type": "string", "format": "date" },
        "evidence": { "type": "string", "format": "uri" },
        "order": { "type": "string" }
      }
    },
    "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } }
  },
  "$defs": {
    "connector": {
      "type": "object",
      "required": ["id", "name", "publisher", "description", "source", "license", "verified", "variants"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "publisher": { "type": "string" },
        "description": { "type": "string", "maxLength": 140 },
        "homepage": { "type": "string", "format": "uri" },
        "source": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "verified": {
          "type": "object",
          "required": ["date", "sources"],
          "properties": {
            "date": { "type": "string", "format": "date" },
            "package": { "type": "string" },
            "version": { "type": "string" },
            "sources": { "type": "array", "items": { "type": "string", "format": "uri" }, "minItems": 1 }
          }
        },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } },
        "popularity": {
          "description": "The entry's place in the order: the publisher's official GitHub repository and its stars on the date in the file's `popularity.read`. `shared`: the repository holds many servers, so its count is the collection's, not this server's.",
          "type": "object",
          "required": ["signal", "repo"],
          "properties": {
            "signal": { "const": "github-stars" },
            "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "stars": { "type": "integer", "minimum": 0 },
            "shared": { "type": "boolean" }
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "required": ["id", "label", "transport", "network"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "default": { "type": "boolean" },
        "summary": { "type": "string" },
        "transport": { "enum": ["stdio", "streamable-http", "sse"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" },
        "auth": { "type": "object" },
        "setup": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["env", "title"],
            "properties": {
              "env": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" },
              "format": { "type": "string" }, "required": { "type": "boolean" }
            }
          }
        },
        "requires": { "type": "array", "items": { "type": "object" } },
        "login": {
          "type": "object",
          "description": "A sign-in command of this variant, reviewed with the entry. A form names it by id and never supplies a command.",
          "required": ["id", "name", "program", "args"],
          "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "program": { "type": "string" }, "args": { "type": "array", "items": { "type": "string" } } }
        },
        "credentials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" }, "title": { "type": "string" }, "env": { "type": "string" },
              "host": { "type": "string" }, "optional": { "type": "boolean" }
            }
          }
        },
        "network": {
          "type": "object",
          "required": ["egress"],
          "properties": {
            "egress": { "oneOf": [ { "enum": ["none", "loopback", "any"] }, { "type": "array", "items": { "type": "string" } } ] }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "transport": { "const": "stdio" } } }, "then": { "required": ["command"] } },
        { "if": { "properties": { "transport": { "enum": ["streamable-http", "sse"] } } }, "then": { "required": ["url"] } }
      ]
    }
  }
}
