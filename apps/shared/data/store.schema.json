          "items": {
            "$ref": "#/$defs/CodeRun"
          }
        },
        "hosts": {
          "$ref": "#/$defs/HostList"
        },
        "secrets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretNeed"
          }
        },
        "files_written": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileWrite"
          }
        },
        "consent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsentItem"
