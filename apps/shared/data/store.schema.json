    "StoreBrowse": {
      "description": "A page of the catalogue, from the local cache. `recommended` is the front page (boopis's own list) and is present on the first page of an unfiltered browse. `stale` says the cache is older than its refresh interval; `offline` says the last refresh failed for lack of a network; `refreshed_at` is the oldest refresh among the searched sources.",
      "type": "object",
      "required": [
        "items",
        "total",
        "next_cursor",
        "refreshed_at",
        "stale",
        "offline"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoreItem"
