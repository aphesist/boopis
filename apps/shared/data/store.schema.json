        "restart_needed": {
          "type": "boolean",
          "description": "The engine must restart for the install to be seen; never silent (the connector rule)."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstallStep"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
