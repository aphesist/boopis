        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          }
        },
        "governed": {
          "$ref": "#/$defs/GovernedNote"
        },
        "cost": {
          "$ref": "#/$defs/Cost"
        },
        "scan": {
          "$ref": "#/$defs/Scan"
        },
        "plugin_hash": {
