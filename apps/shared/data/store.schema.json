        "kind",
        "source",
        "layer",
        "version",
        "pinned",
        "plan_hash",
        "tree_sha256",
        "installed_at",
        "scope",
        "files",
        "enabled",
        "effective",
        "previous",
        "steps",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "$ref": "#/$defs/ItemId"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceId"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "version": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pinned": {
          "$ref": "#/$defs/Pin"
        },
        "plan_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "tree_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "installed_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every path written, home-relative where possible."
        },
        "enabled": {
          "type": "boolean"
        },
        "effective": {
