{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@boopis/ui": ["../../apps/desktop/ui/src/components/index.ts"],
      "@ui/*": ["../../apps/desktop/ui/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../../apps/desktop/ui/vendor/orb-avatar.d.ts", "../../apps/desktop/ui/vendor/boopis-logo.d.ts"]
}
