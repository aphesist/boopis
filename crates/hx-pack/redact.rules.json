{
  "schema_version": 1,
  "description": "Secret redaction rules shared by every implementation (Rust hx-pack::redact, Python hypotaxis.util.redact). Patterns use the syntax common to the Rust regex crate and Python re: no look-around, no possessive quantifiers. Matching is per rule, in order, on the whole text.",
  "placeholder": "[REDACTED:{rule}]",
  "placeholder_prefix": "[REDACTED:",
  "rules": [
    {
      "id": "private_key",
      "description": "A complete PEM or PGP private key block.",
      "pattern": "(?s)-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----.*?-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----",
      "preserve_lines": true
    },
    {
      "id": "private_key_open",
      "description": "A private key header with no footer (a truncated file or window). Everything after it is key material, so the rest of the text goes. Fail closed.",
      "pattern": "(?s)-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----.*",
      "preserve_lines": true
    },
    {
      "id": "anthropic_key",
      "pattern": "\\bsk-ant-[A-Za-z0-9\\-_]{10,}"
    },
    {
      "id": "openai_key",
      "pattern": "\\bsk-(?:proj-|svcacct-)?[A-Za-z0-9\\-_]{16,}"
    },
    {
      "id": "stripe_key",
      "pattern": "\\b[sr]k_(?:live|test)_[0-9A-Za-z]{16,}\\b"
    },
    {
      "id": "aws_access_key",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "github_token",
      "pattern": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{20,}\\b"
    },
    {
      "id": "github_pat",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{20,}\\b"
    },
    {
      "id": "gitlab_token",
      "pattern": "\\bglpat-[A-Za-z0-9\\-_]{20,}"
    },
    {
      "id": "npm_token",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b"
    },
    {
      "id": "hf_token",
      "pattern": "\\bhf_[A-Za-z0-9]{30,}\\b"
    },
    {
      "id": "google_api_key",
      "pattern": "\\bAIza[0-9A-Za-z\\-_]{30,}\\b"
    },
    {
      "id": "slack_token",
      "pattern": "\\bxox[baprs]-[0-9A-Za-z\\-]{10,}\\b"
    },
    {
      "id": "bearer_token",
      "description": "Only the token is replaced; the word Bearer stays.",
      "pattern": "\\b[Bb]earer\\s+(?P<secret>[A-Za-z0-9\\-_\\.=]{20,})"
    },
    {
      "id": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9\\-_]{10,}\\.eyJ[A-Za-z0-9\\-_]{10,}\\.[A-Za-z0-9\\-_]{10,}\\b"
    },
    {
      "id": "url_password",
      "description": "The password in scheme://user:password@host. Only the password is replaced.",
      "pattern": "[A-Za-z][A-Za-z0-9+.\\-]*://[^\\s/@:\"']+:(?P<secret>[^\\s/@\"']+)@"
    },
    {
      "id": "generic_secret",
      "description": "A quoted value assigned to a name that ends in api key, secret, token, password or private key. Only the value is replaced.",
      "pattern": "(?i)[A-Za-z0-9_\\-.]*(?:api_?key|secret(?:_?key)?|(?:access|auth|refresh|bearer|session)_?token|token|passw(?:or)?d|private_?key|client_?secret)[\"']?\\s*[:=]\\s*[\"'](?P<secret>[^\"'\\r\\n]{6,})[\"']",
      "skip_value_prefixes": [
        "${",
        "$(",
        "{{",
        "<",
        "%(",
        "process.env",
        "os.environ",
        "env("
      ]
    }
  ],
  "entropy": {
    "enabled": true,
    "description": "Long, high-entropy tokens that no rule named. Tokens are runs of [A-Za-z0-9+/_-] with optional trailing = padding.",
    "rule_id": "high_entropy",
    "min_length": 32,
    "threshold_bits": 4.2,
    "require_classes": 3,
    "path_like": {
      "description": "A token with at least min_slashes slashes, of which at least min_wordlike_fraction of the segments are lowercase [a-z0-9_-] words, is a path, not a secret.",
      "min_slashes": 2,
      "min_wordlike_fraction": 0.5
    },
    "hex": {
      "description": "Pure hex tokens are hashes and git SHAs far more often than secrets. They are redacted only on a line that names a secret, with a lower threshold because hex tops out at 4 bits.",
      "min_length": 32,
      "threshold_bits": 3.0,
      "sensitive_contexts": [
        "secret",
        "token",
        "passw",
        "api_key",
        "apikey",
        "api-key",
        "private_key",
        "privatekey",
        "credential",
        "auth"
      ]
    },
    "allow": {
      "line_contexts": [
        "integrity",
        "checksum",
        "shasum",
        "sha512",
        "sha384",
        "sha256",
        "sha1",
        "digest",
        "\"resolved\"",
        "resolved:"
      ],
      "token_prefixes": [
        "sha512-",
        "sha384-",
        "sha256-",
        "sha1-",
        "md5-",
        "sha512:",
        "sha256:"
      ],
      "token_patterns": [
        "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
      ],
      "skip_files": [
        "Cargo.lock",
        "package-lock.json",
        "npm-shrinkwrap.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "poetry.lock",
        "uv.lock",
        "Pipfile.lock",
        "go.sum",
        "Gemfile.lock",
        "composer.lock",
        "flake.lock",
        "bun.lock",
        "packages.lock.json"
      ]
    }
  },
  "examples": [
    {
      "input": "key = \"-----BEGIN RSA PRIVATE KEY-----\nMIIEow\n-----END RSA PRIVATE KEY-----\"",
      "output": "key = \"[REDACTED:private_key]\n\n\""
    },
    {
      "input": "ANTHROPIC=sk-ant-api03-abcdefghijklmnop",
      "output": "ANTHROPIC=[REDACTED:anthropic_key]"
    },
    {
      "input": "Authorization: Bearer abcdefghijklmnopqrstuvwxyz0123",
      "output": "Authorization: Bearer [REDACTED:bearer_token]"
    },
    {
      "input": "db = \"postgres://app:hunter2hunter2@db.internal/app\"",
      "output": "db = \"postgres://app:[REDACTED:url_password]@db.internal/app\""
    },
    {
      "input": "STRIPE_API_KEY = \"abc123def456\"",
      "output": "STRIPE_API_KEY = \"[REDACTED:generic_secret]\""
    },
    {
      "input": "password = \"${DB_PASSWORD}\"",
      "output": "password = \"${DB_PASSWORD}\""
    },
    {
      "input": "let tok = \"Zk3Qx9LmP2vR8sT1uW5yB7nC4dF6gH0jKaE\";",
      "output": "let tok = \"[REDACTED:high_entropy]\";"
    },
    {
      "input": "\"integrity\": \"sha512-Zk3Qx9LmP2vR8sT1uW5yB7nC4dF6gH0jKaEZk3Qx9LmP2vR8sT1uW5yB7nC4dF6gH0jKaE==\"",
      "output": "\"integrity\": \"sha512-Zk3Qx9LmP2vR8sT1uW5yB7nC4dF6gH0jKaEZk3Qx9LmP2vR8sT1uW5yB7nC4dF6gH0jKaE==\""
    }
  ]
}
