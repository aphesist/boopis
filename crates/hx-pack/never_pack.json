{
  "schema_version": 1,
  "description": "Files pack never reads, searches, outlines or returns, even when named explicitly. Matching is case-insensitive. Shared data: every implementation reads this file instead of re-typing the list. 'allow' lists exact names that are not withheld even though a name pattern matches; the redactor still runs on them.",
  "allow": [
    {
      "glob": ".env.example",
      "reason": "template with placeholders; redaction still applies"
    },
    {
      "glob": ".env.sample",
      "reason": "template with placeholders; redaction still applies"
    },
    {
      "glob": ".env.template",
      "reason": "template with placeholders; redaction still applies"
    }
  ],
