          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cwd": {
          "description": "Working directory; must lie inside `ro` or `rw`.",
          "type": "string"
        },
        "degraded": {
          "$ref": "#/$defs/Degraded",
