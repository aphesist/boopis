          "description": "Dimensions that may run degraded instead of failing with `hx.sandbox.unavailable`. A\ndegraded network is network **off**."
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Variables to set in the child, on top of the allowlisted ones.",
          "type": "object"
        },
        "env_allowlist": {
          "default": null,
          "description": "Names to copy from the host environment. Default: `PATH`, locale and terminal names only.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "kill_grace_ms": {
          "default": null,
          "description": "Grace between the polite and the forced kill. Default: two seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_file_bytes": {
          "default": null,
          "description": "Largest file a process may write, in bytes. Default 1 GiB; send `0` for no limit.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_processes": {
          "default": null,
          "description": "Processes the tree may add. Default 512; send `0` for no limit.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "memory_bytes": {
          "default": null,
          "description": "Memory limit in bytes. Default 4 GiB; send `0` for no limit.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "net": {
          "$ref": "#/$defs/Net",
          "default": false,
          "description": "Network mode. Default: off."
        },
        "output_cap": {
          "default": null,
          "description": "Per-stream output cap in bytes. Default: 1 MiB.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ro": {
          "default": [],
          "description": "Readable and executable paths.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rw": {
          "default": [],
          "description": "Readable, writable and executable paths.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timeout_ms": {
          "default": null,
          "description": "Wall-clock limit in milliseconds. Default: two minutes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "argv",
        "cwd"
      ],
      "type": "object"
