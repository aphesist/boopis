{
  "$defs": {
    "AbortedBeforeWriteData": {
      "description": "`data` of `hx.txn.aborted_before_write` (next to `data.code`).",
      "properties": {
        "failures": {
          "description": "Every failed edit, in request order.",
          "items": {
            "$ref": "#/$defs/EditFailure"
          },
          "type": "array"
        }
      },
      "required": [
        "failures"
      ],
      "type": "object"
    },
    "ApplyFailedData": {
      "description": "`data` of `hx.txn.apply_failed`.",
      "properties": {
        "restored": {
          "description": "Always true: the workspace was restored before the error was returned.",
          "type": "boolean"
        }
      },
      "required": [
        "restored"
      ],
      "type": "object"
    },
    "ApplyParams": {
      "description": "Parameters of `txn.apply`.",
      "properties": {
        "allowed": {
          "description": "If set, every touched path must match one of these globs.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "edits": {
          "description": "The edits.",
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "type": "array"
        },
        "journal_dir": {
          "description": "Where journals live, under the Hermes profile. Created 0700 if missing.",
          "type": "string"
        },
        "protected": {
          "description": "Paths that may not be touched. Omitted means the built-in defaults; an explicit list,\neven an empty one, replaces them.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "root": {
          "description": "The workspace root directory.",
          "type": "string"
        }
      },
      "required": [
        "root",
        "journal_dir",
        "edits"
      ],
      "type": "object"
    },
    "ApplyResult": {
      "description": "Result of `txn.apply`.",
      "properties": {
        "files": {
          "description": "What changed. Files whose content is unchanged are listed with equal hashes.",
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        },
        "journal_id": {
          "description": "The journal to pass to `txn.restore` or `txn.discard`. A `UUIDv7`.",
          "type": "string"
        }
      },
      "required": [
        "journal_id",
        "files"
      ],
      "type": "object"
    },
    "Capabilities": {
      "description": "What [`crate::capabilities`] reports.",
      "properties": {
        "fs": {
          "$ref": "#/$defs/Capability",
          "description": "Read-only and read-write path confinement, including denying reads elsewhere."
        },
        "inherited_handle": {
          "$ref": "#/$defs/Capability",
          "description": "Passing one extra socket or pipe handle to the child."
        },
        "network_allowlist": {
          "$ref": "#/$defs/Capability",
          "description": "`network: allowlist` of non-loopback hosts. Never available without an external proxy."
        },
        "network_loopback": {
          "$ref": "#/$defs/Capability",
          "description": "`network: loopback`."
        },
        "network_off": {
          "$ref": "#/$defs/Capability",
          "description": "`network: off`."
        },
        "os_version": {
          "description": "Kernel or OS version string, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "description": "`linux`, `macos`, `windows` or `unsupported`.",
          "type": "string"
        },
        "process_tree_kill": {
          "$ref": "#/$defs/Capability",
          "description": "Killing the whole process tree on timeout, cancel or drop."
        }
      },
      "required": [
        "platform",
        "fs",
        "network_off",
        "network_loopback",
        "network_allowlist",
        "process_tree_kill",
        "inherited_handle"
      ],
      "type": "object"
    },
    "Capability": {
      "description": "One thing the host can or cannot do.",
      "properties": {
        "available": {
          "description": "Whether the sandbox can enforce this here, without the policy allowing degrading.",
          "type": "boolean"
        },
        "detail": {
          "description": "Versions, ABIs, and the reason when unavailable.",
          "type": "string"
        },
        "mechanism": {
          "description": "The mechanism used when available, or the best candidate when not.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "detail"
      ],
      "type": "object"
    },
    "Captured": {
      "description": "One captured output stream.",
      "properties": {
        "text": {
          "description": "The first `output_cap_bytes` bytes, decoded as UTF-8 with replacement characters.",
          "type": "string"
        },
        "total_bytes": {
          "description": "How many bytes the child wrote in total, counting the discarded ones.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "More output was produced than the cap, and the rest was discarded.",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "truncated",
        "total_bytes"
      ],
      "type": "object"
    },
    "ChannelInfo": {
      "description": "Where the plugin connects to reach the child's channel.",
      "properties": {
        "env": {
          "description": "The environment variable the child reads its descriptor number from.",
          "type": "string"
        },
        "fd": {
          "description": "The descriptor number the child sees.",
          "format": "int32",
          "type": "integer"
        },
        "kind": {
          "description": "`unix_socket`.",
          "type": "string"
        },
        "path": {
          "description": "The socket path. Connect once; the first connection is bridged to the child and the\nsocket is removed.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "env",
        "fd"
      ],
      "type": "object"
    },
    "ChannelRequest": {
      "description": "Asks `sandbox.spawn` for a private channel between the plugin and the child.\n\n`hx` creates a connected socket pair, gives the child one end under a descriptor number it\nlearns from the environment variable `env`, binds a Unix socket in a private directory\n(mode 0700, the socket 0600), and bridges the first connection to it onto the other end.\nThe child needs no network and no path access to use it, so it works with `net: false`.",
      "properties": {
        "accept_timeout_ms": {
          "default": null,
          "description": "How long to wait for the plugin to connect before closing the child's end.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "dir": {
          "default": null,
          "description": "A directory for the socket. Created with mode 0700 if missing; default: a fresh one\nunder the system temporary directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "default": "HX_CHANNEL_FD",
          "description": "Name of the environment variable that receives the descriptor number in the child.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ClosestMatch": {
      "description": "The closest place in the file to what an edit looked for.",
      "properties": {
        "end_line": {
          "description": "Last line of the closest region, 1-based and inclusive.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "first_diff_line": {
          "description": "The first line, 1-based, where the region differs from the request.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "similarity": {
          "description": "0.0 to 1.0.",
          "format": "double",
          "type": "number"
        },
        "snippet": {
          "description": "The region's text, capped in size.",
          "type": "string"
        },
        "start_line": {
          "description": "First line of the closest region, 1-based.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "whitespace_only": {
          "description": "True when the region differs from the request only in whitespace. The edit is **not**\napplied in that case; resend it with the exact text.",
          "type": "boolean"
        }
      },
      "required": [
        "start_line",
        "end_line",
        "snippet",
        "similarity",
        "whitespace_only"
      ],
      "type": "object"
    },
    "Degraded": {
      "description": "Which dimensions may run with less enforcement than requested, instead of failing with\n`hx.sandbox.unavailable`. Everything defaults to false: the sandbox fails closed.",
      "properties": {
        "fs": {
          "default": false,
          "description": "Run without filesystem confinement if the platform has none.",
          "type": "boolean"
        },
        "network": {
          "default": false,
          "description": "Fall back to **network off** when the requested mode (a host allowlist, or loopback\nwithout the privilege for it) cannot be enforced. Only if even off is impossible does\nthe run go ahead with an unrestricted network, and the report says so.",
          "type": "boolean"
        },
        "process": {
          "default": false,
          "description": "Run without the OS-level process-tree guarantee (the timeout and output cap still apply).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "DeniedData": {
      "description": "`error.data` of `hx.sandbox.denied`.",
      "properties": {
        "os_error": {
          "description": "The OS error.",
          "type": "string"
        },
        "step": {
          "description": "The setup step that failed.",
          "type": "string"
        }
      },
      "required": [
        "step",
        "os_error"
      ],
      "type": "object"
    },
    "DescribeResult": {
      "description": "Result of `hx.describe`.",
      "properties": {
        "capabilities": {
          "description": "Sorted capability strings, such as `txn.edit.diff`. Gate features on these.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocol": {
          "description": "Always `\"hx-v1\"`.",
          "type": "string"
        },
        "version": {
          "description": "The `hx` binary's semantic version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "protocol",
        "capabilities"
      ],
      "type": "object"
    },
    "Dimension": {
      "description": "A policy dimension, for error reporting.",
      "oneOf": [
        {
          "const": "fs",
          "description": "Filesystem confinement (`ro_paths`, `rw_paths`).",
          "type": "string"
        },
        {
          "const": "network",
          "description": "Network access.",
          "type": "string"
        },
        {
          "const": "env",
          "description": "Environment filtering.",
          "type": "string"
        },
        {
          "const": "process",
          "description": "Process limits: timeout, output cap, process-tree kill.",
          "type": "string"
        }
      ]
    },
    "DimensionReport": {
      "description": "The enforcement of one dimension.",
      "properties": {
        "detail": {
          "description": "What the mechanisms cover, what they miss, versions and ABIs.",
          "type": [
            "string",
            "null"
          ]
        },
        "mechanisms": {
          "description": "The OS mechanisms that hold it, such as `landlock` or `appcontainer`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "description": "Whether the dimension is held."
        }
      },
      "required": [
        "status",
        "mechanisms"
      ],
      "type": "object"
    },
    "DiscardResult": {
      "description": "Result of `txn.discard`.",
      "properties": {
        "journal_id": {
          "description": "The journal that was removed.",
          "type": "string"
        }
      },
      "required": [
        "journal_id"
      ],
      "type": "object"
    },
    "Edit": {
      "description": "One edit. Edits apply in order, each seeing the result of the previous ones.",
      "oneOf": [
        {
          "description": "Search and replace. `old` must match exactly once, tolerating CRLF and a uniform indent\nshift. A whitespace-only difference is reported, never applied.",
          "properties": {
            "new": {
              "description": "The replacement.",
              "type": "string"
            },
            "old": {
              "description": "The text to find.",
              "type": "string"
            },
            "op": {
              "const": "replace",
              "type": "string"
            },
            "path": {
              "description": "The file to edit; it must exist.",
              "type": "string"
            },
            "replace_all": {
              "default": false,
              "description": "Replace every exact occurrence instead of requiring exactly one.",
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "path",
            "old",
            "new"
          ],
          "type": "object"
        },
        {
          "description": "Create a whole file, with parent directories.",
          "properties": {
            "content": {
              "description": "The full UTF-8 content.",
              "type": "string"
            },
            "op": {
              "const": "create",
              "type": "string"
            },
            "overwrite": {
              "default": false,
              "description": "Replace the file if it already exists. Without it, an existing file is a failure.",
              "type": "boolean"
            },
            "path": {
              "description": "The file to create.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "content"
          ],
          "type": "object"
        },
        {
          "description": "Delete a file. A symlink is removed itself, not its target.",
          "properties": {
            "op": {
              "const": "delete",
              "type": "string"
            },
            "path": {
              "description": "The file to delete; it must exist.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Apply unified-diff hunks. The diff may carry file headers (`--- a/x`, `+++ b/x`,\n`/dev/null` for create or delete) and several files.",
          "properties": {
            "diff": {
              "description": "The unified diff text.",
              "type": "string"
            },
            "op": {
              "const": "diff",
              "type": "string"
            },
            "path": {
              "description": "The only file the hunks apply to. Required when the diff has no file headers.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "diff"
          ],
          "type": "object"
        }
      ]
    },
    "EditFailure": {
      "description": "One failed edit in an `hx.txn.aborted_before_write` error.",
      "properties": {
        "candidate_lines": {
          "description": "For `ambiguous`, the first line of each candidate, 1-based.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "closest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClosestMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "The closest region, for `no_match`."
        },
        "edit_index": {
          "description": "Index into the request's `edits`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "hunk": {
          "description": "For a diff edit, the zero-based hunk that failed.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FailureKind",
          "description": "What went wrong."
        },
        "message": {
          "description": "A human-readable explanation.",
          "type": "string"
        },
        "path": {
          "description": "The path the edit named (or the diff section's path).",
          "type": "string"
        }
      },
      "required": [
        "edit_index",
        "path",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "Enforcement": {
      "description": "What the sandbox enforced, per dimension, and by which mechanism. Built from what the setup\ncode actually applied, never from the policy alone.",
      "properties": {
        "env": {
          "$ref": "#/$defs/DimensionReport",
          "description": "Environment filtering: the child sees the allowlist and `env_set` only."
        },
        "fs": {
          "$ref": "#/$defs/DimensionReport",
          "description": "Filesystem confinement."
        },
        "network": {
          "$ref": "#/$defs/DimensionReport",
          "description": "Network access."
        },
        "platform": {
          "description": "The platform backend: `linux`, `macos`, `windows` or `unsupported`.",
          "type": "string"
        },
        "process": {
          "$ref": "#/$defs/DimensionReport",
          "description": "Process limits: timeout, output cap and killing the whole process tree."
        }
      },
      "required": [
        "platform",
        "fs",
        "network",
        "env",
        "process"
      ],
      "type": "object"
    },
    "ExitOutcome": {
      "description": "How a child ended.",
      "oneOf": [
        {
          "description": "The process exited by itself with this status code.",
          "properties": {
            "code": {
              "description": "The exit status.",
              "format": "int32",
              "type": "integer"
            },
            "kind": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The process was ended by a signal (Unix only).",
          "properties": {
            "kind": {
              "const": "signaled",
              "type": "string"
            },
            "signal": {
              "description": "The signal number.",
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "signal"
          ],
          "type": "object"
        },
        {
          "description": "The timeout fired and the sandbox killed the process tree.",
          "properties": {
            "kind": {
              "const": "timed_out",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The process never started: the program was not found or could not be executed. The\nsandbox itself was fine, otherwise the call returns an [`crate::Error`] instead.",
          "properties": {
            "kind": {
              "const": "spawn_failed",
              "type": "string"
            },
            "reason": {
              "description": "Why, from the OS.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "FailureKind": {
      "description": "Why one edit failed validation.",
      "oneOf": [
        {
          "const": "no_match",
          "description": "The text was not found. See `closest`.",
          "type": "string"
        },
        {
          "const": "ambiguous",
          "description": "The text matched in several places. See `candidate_lines`.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The file does not exist.",
          "type": "string"
        },
        {
          "const": "already_exists",
          "description": "The file exists and the edit would create it.",
          "type": "string"
        },
        {
          "const": "not_utf8",
          "description": "The file is not valid UTF-8, so it cannot take a text edit.",
          "type": "string"
        },
        {
          "const": "invalid_diff",
          "description": "The diff text could not be parsed.",
          "type": "string"
        },
        {
          "const": "path_unsafe",
          "description": "The path is absolute, contains `..`, or escapes the workspace through a symlink.",
          "type": "string"
        },
        {
          "const": "is_directory",
          "description": "The path is a directory.",
          "type": "string"
        },
        {
          "const": "not_regular",
          "description": "The path is not a regular file or symlink.",
          "type": "string"
        },
        {
          "const": "unreadable",
          "description": "The file exists but cannot be read.",
          "type": "string"
        },
        {
          "const": "too_large",
          "description": "The file or the transaction exceeds a size limit.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The edit asks for something unsupported, such as a rename in a diff.",
          "type": "string"
        }
      ]
    },
    "FileChange": {
      "description": "One touched file in a result.",
      "properties": {
        "created": {
          "description": "The transaction created the file.",
          "type": "boolean"
        },
        "deleted": {
          "description": "The transaction deleted the file.",
          "type": "boolean"
        },
        "path": {
          "description": "The real path, workspace-relative, after resolving symlinks inside the workspace.",
          "type": "string"
        },
        "sha256_after": {
          "description": "SHA-256 of the content after, or null if the file was deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "sha256_before": {
          "description": "SHA-256 of the content before, or null if the file did not exist.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "created",
        "deleted"
      ],
      "type": "object"
    },
    "JournalData": {
      "description": "`data` of the journal errors (`journal_not_found`, `journal_corrupt`, `journal_busy`,\n`invalid_state`, `restore_failed`).",
      "properties": {
        "journal_id": {
          "description": "The journal the error is about.",
          "type": "string"
        }
      },
      "required": [
        "journal_id"
      ],
      "type": "object"
    },
    "JournalRef": {
      "description": "Parameters of `txn.restore` and `txn.discard`.",
      "properties": {
        "journal_dir": {
          "description": "The journal directory the transaction used.",
          "type": "string"
        },
        "journal_id": {
          "description": "The id `txn.apply` returned.",
          "type": "string"
        }
      },
      "required": [
        "journal_dir",
        "journal_id"
      ],
      "type": "object"
    },
    "Net": {
      "anyOf": [
        {
          "description": "`false` is off, `true` is unrestricted.",
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/NetMode",
          "description": "A named mode."
        },
        {
          "description": "An allowlist of hosts. Only loopback names can be enforced; see\n[`NetworkPolicy::Allowlist`].",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "The `net` parameter: `false` (off), `true` (unrestricted), `\"loopback\"`, or a list of hosts."
    },
    "NetMode": {
      "description": "Named network modes for [`Net`].",
      "oneOf": [
        {
          "const": "off",
          "description": "No network.",
          "type": "string"
        },
        {
          "const": "loopback",
          "description": "Loopback only.",
          "type": "string"
        },
        {
          "const": "on",
          "description": "Unrestricted.",
          "type": "string"
        }
      ]
    },
    "PathsData": {
      "description": "`data` of `hx.txn.scope_violation` and `hx.txn.protected_path`.",
      "properties": {
        "paths": {
          "description": "The offending paths, as normalised from the request.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    },
    "RecoverFailure": {
      "description": "A journal `txn.recover` could not finish.",
      "properties": {
        "code": {
          "description": "The stable error code.",
          "type": "string"
        },
        "journal_id": {
          "description": "The journal id (the directory name when the manifest is unreadable).",
          "type": "string"
        },
        "message": {
          "description": "What happened.",
          "type": "string"
        }
      },
      "required": [
