{
  "$defs": {
    "AbortedBeforeWriteData": {
      "description": "`data` of `hx.txn.aborted_before_write` (next to `data.code`).",
      "properties": {
        "failures": {
          "description": "Every failed edit, in request order.",
          "items": {
            "$ref": "#/$defs/EditFailure"
          },
          "type": "array"
        }
      },
      "required": [
        "failures"
      ],
      "type": "object"
    },
    "ApplyFailedData": {
      "description": "`data` of `hx.txn.apply_failed`.",
      "properties": {
        "restored": {
          "description": "Always true: the workspace was restored before the error was returned.",
          "type": "boolean"
        }
      },
      "required": [
        "restored"
      ],
      "type": "object"
    },
    "ApplyParams": {
      "description": "Parameters of `txn.apply`.",
      "properties": {
        "allowed": {
          "description": "If set, every touched path must match one of these globs.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "edits": {
          "description": "The edits.",
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "type": "array"
        },
        "journal_dir": {
          "description": "Where journals live, under the Hermes profile. Created 0700 if missing.",
          "type": "string"
        },
        "protected": {
          "description": "Paths that may not be touched. Omitted means the built-in defaults; an explicit list,\neven an empty one, replaces them.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "root": {
          "description": "The workspace root directory.",
          "type": "string"
        }
      },
      "required": [
        "root",
        "journal_dir",
        "edits"
      ],
      "type": "object"
    },
    "ApplyResult": {
      "description": "Result of `txn.apply`.",
      "properties": {
        "files": {
          "description": "What changed. Files whose content is unchanged are listed with equal hashes.",
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        },
        "journal_id": {
          "description": "The journal to pass to `txn.restore` or `txn.discard`. A `UUIDv7`.",
          "type": "string"
        }
      },
      "required": [
        "journal_id",
        "files"
      ],
      "type": "object"
    },
    "ClosestMatch": {
      "description": "The closest place in the file to what an edit looked for.",
      "properties": {
        "end_line": {
          "description": "Last line of the closest region, 1-based and inclusive.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "first_diff_line": {
          "description": "The first line, 1-based, where the region differs from the request.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "similarity": {
          "description": "0.0 to 1.0.",
          "format": "double",
          "type": "number"
        },
        "snippet": {
          "description": "The region's text, capped in size.",
          "type": "string"
        },
        "start_line": {
          "description": "First line of the closest region, 1-based.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "whitespace_only": {
          "description": "True when the region differs from the request only in whitespace. The edit is **not**\napplied in that case; resend it with the exact text.",
          "type": "boolean"
        }
      },
      "required": [
        "start_line",
        "end_line",
        "snippet",
        "similarity",
        "whitespace_only"
      ],
      "type": "object"
    },
    "DescribeResult": {
      "description": "Result of `hx.describe`.",
      "properties": {
        "capabilities": {
          "description": "Sorted capability strings, such as `txn.edit.diff`. Gate features on these.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocol": {
          "description": "Always `\"hx-v1\"`.",
          "type": "string"
        },
        "version": {
          "description": "The `hx` binary's semantic version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "protocol",
        "capabilities"
      ],
      "type": "object"
    },
    "DiscardResult": {
      "description": "Result of `txn.discard`.",
      "properties": {
        "journal_id": {
          "description": "The journal that was removed.",
          "type": "string"
        }
      },
      "required": [
        "journal_id"
      ],
      "type": "object"
    },
    "Edit": {
      "description": "One edit. Edits apply in order, each seeing the result of the previous ones.",
      "oneOf": [
        {
          "description": "Search and replace. `old` must match exactly once, tolerating CRLF and a uniform indent\nshift. A whitespace-only difference is reported, never applied.",
          "properties": {
            "new": {
              "description": "The replacement.",
              "type": "string"
            },
            "old": {
              "description": "The text to find.",
              "type": "string"
            },
            "op": {
              "const": "replace",
              "type": "string"
            },
            "path": {
              "description": "The file to edit; it must exist.",
              "type": "string"
            },
            "replace_all": {
              "default": false,
              "description": "Replace every exact occurrence instead of requiring exactly one.",
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "path",
            "old",
            "new"
          ],
          "type": "object"
        },
        {
          "description": "Create a whole file, with parent directories.",
          "properties": {
            "content": {
              "description": "The full UTF-8 content.",
              "type": "string"
            },
            "op": {
              "const": "create",
              "type": "string"
            },
            "overwrite": {
              "default": false,
              "description": "Replace the file if it already exists. Without it, an existing file is a failure.",
              "type": "boolean"
            },
            "path": {
              "description": "The file to create.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "path",
            "content"
          ],
          "type": "object"
        },
        {
          "description": "Delete a file. A symlink is removed itself, not its target.",
          "properties": {
            "op": {
              "const": "delete",
              "type": "string"
            },
            "path": {
              "description": "The file to delete; it must exist.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Apply unified-diff hunks. The diff may carry file headers (`--- a/x`, `+++ b/x`,\n`/dev/null` for create or delete) and several files.",
          "properties": {
            "diff": {
              "description": "The unified diff text.",
              "type": "string"
            },
            "op": {
              "const": "diff",
              "type": "string"
            },
            "path": {
              "description": "The only file the hunks apply to. Required when the diff has no file headers.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "diff"
          ],
          "type": "object"
        }
      ]
    },
    "EditFailure": {
      "description": "One failed edit in an `hx.txn.aborted_before_write` error.",
      "properties": {
        "candidate_lines": {
          "description": "For `ambiguous`, the first line of each candidate, 1-based.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "closest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClosestMatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "The closest region, for `no_match`."
        },
        "edit_index": {
          "description": "Index into the request's `edits`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "hunk": {
          "description": "For a diff edit, the zero-based hunk that failed.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FailureKind",
          "description": "What went wrong."
        },
        "message": {
          "description": "A human-readable explanation.",
          "type": "string"
        },
        "path": {
          "description": "The path the edit named (or the diff section's path).",
          "type": "string"
        }
      },
      "required": [
        "edit_index",
        "path",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "FailureKind": {
      "description": "Why one edit failed validation.",
      "oneOf": [
        {
          "const": "no_match",
          "description": "The text was not found. See `closest`.",
          "type": "string"
        },
        {
          "const": "ambiguous",
          "description": "The text matched in several places. See `candidate_lines`.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The file does not exist.",
          "type": "string"
        },
        {
          "const": "already_exists",
          "description": "The file exists and the edit would create it.",
          "type": "string"
        },
        {
          "const": "not_utf8",
          "description": "The file is not valid UTF-8, so it cannot take a text edit.",
          "type": "string"
        },
        {
          "const": "invalid_diff",
          "description": "The diff text could not be parsed.",
          "type": "string"
        },
        {
          "const": "path_unsafe",
          "description": "The path is absolute, contains `..`, or escapes the workspace through a symlink.",
          "type": "string"
        },
        {
          "const": "is_directory",
          "description": "The path is a directory.",
          "type": "string"
        },
        {
          "const": "not_regular",
          "description": "The path is not a regular file or symlink.",
          "type": "string"
        },
        {
          "const": "unreadable",
          "description": "The file exists but cannot be read.",
          "type": "string"
        },
        {
          "const": "too_large",
          "description": "The file or the transaction exceeds a size limit.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The edit asks for something unsupported, such as a rename in a diff.",
          "type": "string"
        }
      ]
    },
    "FileChange": {
      "description": "One touched file in a result.",
      "properties": {
        "created": {
          "description": "The transaction created the file.",
          "type": "boolean"
        },
        "deleted": {
          "description": "The transaction deleted the file.",
          "type": "boolean"
        },
        "path": {
          "description": "The real path, workspace-relative, after resolving symlinks inside the workspace.",
          "type": "string"
        },
        "sha256_after": {
          "description": "SHA-256 of the content after, or null if the file was deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "sha256_before": {
          "description": "SHA-256 of the content before, or null if the file did not exist.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "created",
        "deleted"
      ],
      "type": "object"
    },
    "JournalData": {
      "description": "`data` of the journal errors (`journal_not_found`, `journal_corrupt`, `journal_busy`,\n`invalid_state`, `restore_failed`).",
      "properties": {
        "journal_id": {
          "description": "The journal the error is about.",
          "type": "string"
        }
      },
      "required": [
        "journal_id"
      ],
      "type": "object"
    },
    "JournalRef": {
      "description": "Parameters of `txn.restore` and `txn.discard`.",
      "properties": {
        "journal_dir": {
          "description": "The journal directory the transaction used.",
          "type": "string"
        },
        "journal_id": {
          "description": "The id `txn.apply` returned.",
          "type": "string"
        }
      },
      "required": [
        "journal_dir",
        "journal_id"
      ],
      "type": "object"
    },
    "PathsData": {
      "description": "`data` of `hx.txn.scope_violation` and `hx.txn.protected_path`.",
      "properties": {
        "paths": {
          "description": "The offending paths, as normalised from the request.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    },
    "RecoverFailure": {
      "description": "A journal `txn.recover` could not finish.",
      "properties": {
        "code": {
          "description": "The stable error code.",
          "type": "string"
        },
        "journal_id": {
          "description": "The journal id (the directory name when the manifest is unreadable).",
          "type": "string"
        },
        "message": {
          "description": "What happened.",
          "type": "string"
        }
      },
      "required": [
        "journal_id",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RecoverParams": {
      "description": "Parameters of `txn.recover`.",
      "properties": {
        "journal_dir": {
          "description": "The journal directory to scan.",
          "type": "string"
        }
      },
      "required": [
        "journal_dir"
      ],
      "type": "object"
    },
    "RecoverResult": {
      "description": "Result of `txn.recover`.",
      "properties": {
        "busy": {
          "description": "Journals held by a live transaction. Left alone.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "discarded": {
          "description": "Journals that never reached the workspace and were just removed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "failed": {
          "description": "Journals that could not be recovered; they are kept.",
          "items": {
            "$ref": "#/$defs/RecoverFailure"
          },
          "type": "array"
        },
        "pending": {
          "description": "Completed transactions still waiting for `txn.restore` or `txn.discard`. Left alone.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "restored": {
          "description": "Interrupted transactions that were rolled back.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "restored",
        "discarded",
        "pending",
        "busy",
        "failed"
      ],
      "type": "object"
    },
    "RestoreResult": {
      "description": "Result of `txn.restore`.",
      "properties": {
        "journal_id": {
          "description": "The journal that was consumed.",
          "type": "string"
        },
        "removed": {
          "description": "Paths the transaction had created, now removed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "restored": {
          "description": "Paths whose bytes and metadata were put back (including recreated deletions).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "journal_id",
        "restored",
        "removed"
      ],
      "type": "object"
    },
    "ValidateParams": {
      "description": "Parameters of `txn.validate`.",
      "properties": {
        "allowed": {
          "description": "If set, every touched path must match one of these globs.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "edits": {
          "description": "The edits.",
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "type": "array"
        },
        "protected": {
          "description": "Paths that may not be touched. Omitted means the built-in defaults\n(`crates/hx-txn/protected.default.json`); an explicit list, even an empty one, replaces them.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "root": {
          "description": "The workspace root directory.",
          "type": "string"
        }
      },
      "required": [
        "root",
        "edits"
      ],
      "type": "object"
    },
    "ValidateResult": {
      "description": "Result of `txn.validate`.",
      "properties": {
        "files": {
          "description": "What `txn.apply` would change. Nothing was written.",
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "errors": {
    "hx.txn.aborted_before_write": {
      "data": {
        "$ref": "#/$defs/AbortedBeforeWriteData"
      }
    },
    "hx.txn.apply_failed": {
      "data": {
        "$ref": "#/$defs/ApplyFailedData"
      }
    },
    "hx.txn.invalid_state": {
      "data": {
        "$ref": "#/$defs/JournalData"
      }
    },
    "hx.txn.journal_busy": {
      "data": {
        "$ref": "#/$defs/JournalData"
      }
    },
    "hx.txn.journal_corrupt": {
      "data": {
        "$ref": "#/$defs/JournalData"
      }
    },
    "hx.txn.journal_not_found": {
      "data": {
        "$ref": "#/$defs/JournalData"
      }
    },
    "hx.txn.protected_path": {
      "data": {
        "$ref": "#/$defs/PathsData"
      }
    },
    "hx.txn.restore_failed": {
      "data": {
        "$ref": "#/$defs/JournalData"
      }
    },
    "hx.txn.scope_violation": {
      "data": {
        "$ref": "#/$defs/PathsData"
      }
    }
  },
  "methods": {
    "hx.describe": {
      "params": null,
      "result": {
        "$ref": "#/$defs/DescribeResult"
      }
    },
    "txn.apply": {
      "params": {
        "$ref": "#/$defs/ApplyParams"
      },
      "result": {
        "$ref": "#/$defs/ApplyResult"
      }
    },
    "txn.discard": {
      "params": {
        "$ref": "#/$defs/JournalRef"
      },
      "result": {
        "$ref": "#/$defs/DiscardResult"
      }
    },
    "txn.recover": {
      "params": {
        "$ref": "#/$defs/RecoverParams"
      },
      "result": {
        "$ref": "#/$defs/RecoverResult"
      }
    },
    "txn.restore": {
      "params": {
        "$ref": "#/$defs/JournalRef"
      },
      "result": {
        "$ref": "#/$defs/RestoreResult"
      }
    },
    "txn.validate": {
      "params": {
        "$ref": "#/$defs/ValidateParams"
      },
      "result": {
        "$ref": "#/$defs/ValidateResult"
      }
    }
  },
  "protocol": "hx-v1",
  "title": "hx-v1"
}
