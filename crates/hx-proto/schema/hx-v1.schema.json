      ],
      "type": "object"
    },
    "SandboxRunParams": {
      "description": "Params of `sandbox.run`.",
      "properties": {
        "argv": {
          "description": "The program and its arguments. Never a shell string.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cpu_seconds": {
          "default": null,
          "description": "CPU seconds. Default: as many as the timeout; send `0` for no limit.",
