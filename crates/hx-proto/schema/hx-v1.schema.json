        "code",
        "message"
      ],
      "type": "object"
    },
    "RecoverParams": {
      "description": "Parameters of `txn.recover`.",
      "properties": {
        "journal_dir": {
          "description": "The journal directory to scan.",
          "type": "string"
        }
      },
      "required": [
        "journal_dir"
      ],
      "type": "object"
    },
    "RecoverResult": {
      "description": "Result of `txn.recover`.",
      "properties": {
        "busy": {
          "description": "Journals held by a live transaction. Left alone.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "discarded": {
          "description": "Journals that never reached the workspace and were just removed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "failed": {
          "description": "Journals that could not be recovered; they are kept.",
          "items": {
            "$ref": "#/$defs/RecoverFailure"
          },
          "type": "array"
        },
        "pending": {
          "description": "Completed transactions still waiting for `txn.restore` or `txn.discard`. Left alone.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "restored": {
          "description": "Interrupted transactions that were rolled back.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "restored",
        "discarded",
        "pending",
        "busy",
        "failed"
      ],
      "type": "object"
    },
    "RestoreResult": {
      "description": "Result of `txn.restore`.",
      "properties": {
        "journal_id": {
          "description": "The journal that was consumed.",
          "type": "string"
        },
        "removed": {
          "description": "Paths the transaction had created, now removed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "restored": {
          "description": "Paths whose bytes and metadata were put back (including recreated deletions).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "journal_id",
        "restored",
        "removed"
      ],
      "type": "object"
    },
    "RunResult": {
      "description": "The result of [`crate::run`].",
      "properties": {
        "duration_ms": {
          "description": "Wall-clock time from spawn to exit, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enforcement": {
          "$ref": "#/$defs/Enforcement",
          "description": "What was enforced. When `exit` is `spawn_failed`, this is what was applied up to the\npoint the program failed to start."
        },
        "exit": {
          "$ref": "#/$defs/ExitOutcome",
          "description": "How the child ended."
        },
        "stderr": {
          "$ref": "#/$defs/Captured",
          "description": "Captured standard error."
        },
        "stdout": {
          "$ref": "#/$defs/Captured",
          "description": "Captured standard output."
        }
      },
      "required": [
        "exit",
        "stdout",
        "stderr",
        "duration_ms",
        "enforcement"
      ],
      "type": "object"
    },
    "SandboxKillParams": {
      "description": "Params of `sandbox.kill`.",
