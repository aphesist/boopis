{
  "description": "An approval prompt becomes permission_prompt.",
  "event": "Notification",
  "setup": [],
  "call": {
    "hook": "on_human_input_request",
    "kwargs": {
      "kind": "approval",
      "request_id": "r1",
      "session_id": "sess-1",
      "session_key": "k",
      "platform": "desktop",
      "prompt": "rm -rf build"
