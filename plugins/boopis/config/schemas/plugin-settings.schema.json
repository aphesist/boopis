{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "boopis plugin settings (plugins.entries.boopis.settings)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "governed",
        "ungoverned"
      ],
      "default": "governed"
    },
    "ladder": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "tiers"
      ],
      "properties": {
        "same_tier_scope_retry": {
          "type": "boolean"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "model"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "pattern": "^[^/\\s]+/\\S+$"
              },
              "effort": {
                "type": "string",
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "max_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "retries": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "cost_cap_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "prices": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "refresh_enabled": {
          "type": "boolean",
          "default": true
        },
        "overrides": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cache_read": {
                "type": "number",
                "minimum": 0
              },
              "cache_write_5m": {
                "type": "number",
                "minimum": 0
              },
              "cache_write_1h": {
                "type": "number",
                "minimum": 0
              },
              "reasoning": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "aliases": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subscription_providers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "claude-subscription-directsdk-experimental",
        "openai-codex"
      ]
    },
    "permissions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ask": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "default": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "allow"
        }
      }
    },
    "hx_path": {
      "type": "string",
      "default": ""
    },
    "ledger_dir": {
      "type": "string",
      "default": ""
    },
    "pack": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304,
          "default": 131072
        }
      }
    },
    "start_tier": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "forks": {
      "type": "boolean",
      "default": false
    },
    "cascade": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "output_tail_chars": {
          "type": "integer",
          "minimum": 200,
          "maximum": 20000,
          "default": 3000
        },
        "diff_chars": {
          "type": "integer",
          "minimum": 200,
          "maximum": 100000,
          "default": 6000
        },
        "brief_max_chars": {
          "type": "integer",
          "minimum": 500,
          "maximum": 100000,
          "default": 8000
        }
      }
    },
    "exec": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 120000,
          "maximum": 3600000
        },
        "max_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 300000,
          "maximum": 3600000
        },
        "kill_grace_ms": {
          "type": "integer",
          "minimum": 100,
          "default": 5000,
          "maximum": 60000
        },
        "start_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 15000,
          "maximum": 120000
        },
        "max_calls_per_cell": {
          "type": "integer",
          "minimum": 1,
          "default": 50,
          "maximum": 10000
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "default": 8,
          "maximum": 64
        },
        "output_cap_bytes": {
          "type": "integer",
          "minimum": 1024,
          "default": 30000,
          "maximum": 1048576
        },
        "result_cap_bytes": {
          "type": "integer",
          "minimum": 256,
          "default": 10000,
          "maximum": 1048576
        },
        "spill_cap_bytes": {
          "type": "integer",
          "minimum": 4096,
          "default": 16777216,
          "maximum": 268435456
        },
        "call_result_cap_bytes": {
          "type": "integer",
          "minimum": 1024,
          "default": 1048576,
          "maximum": 33554432
        },
        "sh_output_cap_bytes": {
          "type": "integer",
          "minimum": 1024,
          "default": 1048576,
          "maximum": 67108864
        },
        "max_kernels": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "maximum": 32
        },
        "idle_timeout_s": {
          "type": "integer",
          "minimum": 10,
          "default": 900,
          "maximum": 86400
        },
        "max_lifetime_s": {
          "type": "integer",
          "minimum": 60,
          "default": 3600,
          "maximum": 3600
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 64,
          "default": 2048,
          "maximum": 65536
        },
        "max_processes": {
          "type": "integer",
          "minimum": 8,
          "default": 256,
          "maximum": 4096
        },
        "network": {
          "type": "string",
          "enum": [
            "off",
            "loopback",
            "on"
          ],
          "default": "off"
        }
      }
    },
    "forms": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "max_open": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20
        },
        "expires_s": {
          "type": "integer",
          "minimum": 30,
          "maximum": 604800,
          "default": 3600
        },
        "wait_default_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 120
        },
        "wait_max_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 300
        }
      }
    },
    "gate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "allow_unsandboxed": {
          "type": "boolean",
          "default": false,
          "description": "Run the ship gate's test command without the OS sandbox when this machine cannot provide one. Off by default: an unavailable sandbox blocks the gate. A user choice only; every unsandboxed run is logged and recorded."
        }
      }
    }
  }
}
